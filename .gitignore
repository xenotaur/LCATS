# Ignore Emacs backup files
*~

# Ignore .pyc files
*.pyc

# Ignore compiled Python files
__pycache__/

# Ignore virtual environment directories
venv/
env/

# Ignore logs and temporary files
temp
tmp
lcats/tmp
lcats/temp
lcats/tempspace
*.log
*.tmp


# Ignore output files used for debugging
*.out

# Ignore database files
*.db
*.sqlite

# Ignore system files
.DS_Store
Thumbs.db

# Ignore local copies of data corpus.
data/
lcats/data
lcats/lcats/data
lcats/notebooks/data
lcats/lcats/notebooks/data

# Ignore local copies of cache files.
cache/
lcats/cache
lcats/lcats/cache
lcats/notebooks/cache
lcats/lcats/notebooks/cache

# Ignore local workspace files
workspace/
lcats/workspace
lcats/notebooks/workspace
lcats/lcats/notebooks/workspace


# Ignore local output files.
output/

# Ignore package build directories
dist/
build/

# Ignore IDE-specific files
.idea/
.vscode/

# Ignore compiled binaries
*.exe
*.dll
*.so
*.dylib

# Ignore package installation files
*.egg-info/
*.egg

# Ignore cache directories
__pycache__/
.cache/

# Ignore coverage reports
.coverage
htmlcov/

# Ignore documentation files
docs/_build/

# Ignore notebook outputs
lcats/notebooks/output/
lcats/notebooks/Output/
lcats/lcats/notebooks/output/
lcats/lcats/notebooks/Output/

# Ignore local secrets files (e.g. API keys).
.secrets/

# Ignore secrets_hygiene scan/purge output (contains real secret material
# read from git history — never commit it).
lcats/experimental/secrets_hygiene/scratch/

# Ignore genre-census per-story checkpoint state (internal resume cache,
# redundant with the committed census_*_stories.jsonl/summary.json).
# Targets the checkpoint file's own fixed name (run_census.py's
# "genre_census" stage) rather than every subdirectory - a blanket
# results/*/ pattern would also ignore a candidate-scoped results
# subdirectory's own real committed output (review finding, PR #292).
experiments/04_genre_census/results/**/genre_census.json

# Ignore WI-PILOT-0067 stability-gate per-story checkpoint sidecars.
# The committed evidence is the gate's JSON/JSONL/Markdown report files
# directly under results/stability_gate/; checkpoint subdirectories are
# local resume/debug state produced by run_pilot.py.
experiments/03_cross_segment_relation_pilot/results/stability_gate/fixtures__*/

# Ignore WI-GENRE-0004 --validate per-story checkpoint state (internal
# resume cache, redundant with the committed
# validation_results.jsonl/validation_summary.json/validation_run_log.jsonl).
# Same targeted-filename approach as the genre-census pattern above (not
# a blanket results/*/ pattern, for the same PR #292 reason).
experiments/05_metadata_genre_prefilter/results/**/validation.json
