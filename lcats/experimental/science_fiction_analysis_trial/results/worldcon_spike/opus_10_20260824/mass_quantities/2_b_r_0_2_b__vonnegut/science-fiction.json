          "confidence": 0.95,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-f3caf5cee65ce1ae",
          "evidence_type": "storyworld_change",
          "paraphrase": "Disease and aging have been cured.",
