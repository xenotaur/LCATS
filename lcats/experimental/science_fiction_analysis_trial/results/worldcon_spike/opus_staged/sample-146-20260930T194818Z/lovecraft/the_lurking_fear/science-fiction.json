            ],
            "start_char": 46999
          },
          "confidence": 0.68,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-94d90d9a232ebb0f",
          "evidence_type": "reader_facing_contrast",
          "paraphrase": "The narrator suggests his discovery casts dread over the reader's ordinary sense of the wider world.",
          "provenance": [
            {
              "backend": "anthropic",
              "normalization_notes": [
                "used bounded whitespace/typography/case fallback"
              ],
              "raw_id": "ev14",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "Who can, with my knowledge, think of the earth's unknown caverns without a nightmare dread of future possibilities?"
        },
        {
          "anchor": {
            "end_char": 46721,
            "paragraph_ids": [
              "p00073"
            ],
            "start_char": 46434
          },
          "confidence": 0.72,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-aca12ca2dedb181b",
          "evidence_type": "storyworld_change",
          "paraphrase": "The narrator arranges to dynamite the mansion and mountain top and seal the burrows.",
          "provenance": [
            {
              "backend": "anthropic",
              "normalization_notes": [
                "used bounded whitespace/typography/case fallback"
              ],
              "raw_id": "ev13",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "I had recovered enough in a week to send to Albany for a gang of men to blow up the Martense mansion and the entire top of Tempest Mountain with dynamite, stop up all the discoverable mound-burrows, and destroy certain overnourished trees whose very existence seemed an insult to sanity."
        },
        {
          "anchor": {
            "end_char": 16049,
            "paragraph_ids": [
              "p00028"
            ],
            "start_char": 15713
          },
          "confidence": 0.8,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-c7abc6043ca7deb9",
          "evidence_type": "inquiry_or_scientific_method",
          "paraphrase": "The narrator and his colleague systematically tabulate reported incidents and detect a geographic trend correlating horrors with proximity to the mansion.",
          "provenance": [
            {
              "backend": "anthropic",
              "normalization_notes": [
                "used bounded whitespace/typography/case fallback"
              ],
              "raw_id": "ev01",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "The results of this examination were not at first very enlightening, though our tabulation of them seemed to reveal a fairly significant trend; namely, that the number of reported horrors was by far the greatest in areas either comparatively near the avoided house or connected with it by stretches of the morbidly overnourished forest."
        },
        {
          "anchor": {
            "end_char": 17125,
            "paragraph_ids": [
