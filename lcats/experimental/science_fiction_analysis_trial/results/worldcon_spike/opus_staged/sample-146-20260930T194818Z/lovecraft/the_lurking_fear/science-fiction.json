            ],
            "start_char": 16994
          },
          "confidence": 0.78,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-d66a9782e990d6d5",
          "evidence_type": "scientific_or_technical_explanation",
          "paraphrase": "The squatters are explained as having degenerated along an evolutionary trajectory due to ancestry and isolation.",
          "provenance": [
            {
              "backend": "anthropic",
              "normalization_notes": [
                "used bounded whitespace/typography/case fallback"
              ],
              "raw_id": "ev03",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "Simple animals they were, gently descending the evolutionary scale because of their unfortunate ancestry and stultifying isolation."
        },
