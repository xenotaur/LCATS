          "confidence": 0.8,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-b512bd90ca955265",
          "evidence_type": "extrapolative_consequence",
          "paraphrase": "Earth goods cause the collapse of the local ceramic pot business.",
