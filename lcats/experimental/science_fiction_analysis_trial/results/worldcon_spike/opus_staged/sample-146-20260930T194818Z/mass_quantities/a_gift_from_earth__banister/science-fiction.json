          "confidence": 0.9,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-6ba31a42a08b19b0",
          "evidence_type": "temporal_or_spatial_displacement",
          "paraphrase": "The story is set on an alien planet, Zur, visited by humans from Earth.",
