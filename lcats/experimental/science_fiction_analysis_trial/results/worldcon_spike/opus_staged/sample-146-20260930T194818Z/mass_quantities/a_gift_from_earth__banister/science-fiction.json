          "confidence": 0.85,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-7ed9df12bafd0508",
          "evidence_type": "storyworld_change",
          "paraphrase": "Earthmen introduce telegraph lines and instantaneous communication across Zur.",
