            ],
            "start_char": 16910
          },
          "confidence": 0.7,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-1725c0e0844dd763",
          "evidence_type": "storyworld_change",
          "paraphrase": "She claims to have introduced fire, a new thing, into the world.",
          "provenance": [
            {
              "backend": "anthropic",
              "normalization_notes": [
                "used bounded whitespace/typography/case fallback"
              ],
              "raw_id": "ev10",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "I had created something that didn't exist before; I had added a new thing to the world's uncountable properties"
        },
        {
          "anchor": {
            "end_char": 27450,
            "paragraph_ids": [
              "p00063"
