            {
              "backend": "anthropic",
              "normalization_notes": [
                "used bounded whitespace/typography/case fallback"
              ],
              "raw_id": "ev13",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "When the mighty brontosaurus came striding into camp, she regarded it as an acquisition, I considered it a calamity; that is a good sample of the lack of harmony that prevails in our views of things."
        },
        {
          "anchor": {
            "end_char": 1509,
            "paragraph_ids": [
