          },
          "confidence": 0.7,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-dd8bea387fa94818",
          "evidence_type": "character_reaction",
          "paraphrase": "Through fire she discovers the new emotion of fear.",
