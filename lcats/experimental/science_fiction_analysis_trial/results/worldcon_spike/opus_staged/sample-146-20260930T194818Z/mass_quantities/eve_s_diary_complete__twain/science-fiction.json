          },
          "confidence": 0.7,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-a747279c1de59e9d",
          "evidence_type": "storyworld_change",
          "paraphrase": "She depicts the moon as a physical ornament that fell out of the cosmic scheme.",
          "provenance": [
            {
              "backend": "anthropic",
              "normalization_notes": [
                "used bounded whitespace/typography/case fallback"
              ],
              "raw_id": "ev03",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "The moon got loose last night, and slid down and fell out of the scheme--a very great loss; it breaks my heart to think of it."
        },
