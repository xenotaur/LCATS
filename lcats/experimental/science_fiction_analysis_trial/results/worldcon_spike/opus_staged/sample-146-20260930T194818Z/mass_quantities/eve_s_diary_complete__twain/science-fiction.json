            ],
            "start_char": 25804
          },
          "confidence": 0.55,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-69e31d9bfd02b5ca",
          "evidence_type": "temporal_or_spatial_displacement",
          "paraphrase": "She travels widely across the new world and calls herself its first traveler.",
          "provenance": [
            {
              "backend": "anthropic",
              "normalization_notes": [
                "used bounded whitespace/typography/case fallback"
              ],
              "raw_id": "ev19",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "We have made long excursions, and I have seen a great deal of the world; almost all of it, I think; and so I am the first traveler, and the only one."
        },
        {
          "anchor": {
            "end_char": 851,
            "paragraph_ids": [
