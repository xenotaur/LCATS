          },
          "confidence": 0.6,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-8ecbdf43f9e94a27",
          "evidence_type": "inquiry_or_scientific_method",
          "paraphrase": "She experiments by trying to physically reach the stars and is surprised they are unreachable.",
          "provenance": [
