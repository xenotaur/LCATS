              "backend": "anthropic",
              "normalization_notes": [
                "used bounded whitespace/typography/case fallback"
              ],
              "raw_id": "ev04",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "When they first showed, last night, I tried to knock some down with a pole, but it didn't reach, which astonished me; then I tried clods till I was all tired out, but I never got one."
        },
