            ],
            "start_char": 10377
          },
          "confidence": 0.8,
          "entity_ids": [],
          "event_ids": [],
          "evidence_id": "sfev-4686accf2c09656d",
          "evidence_type": "scientific_or_technical_explanation",
          "paraphrase": "Hitz explains the exponential population growth that prompted control.",
          "provenance": [
            {
              "backend": "anthropic",
              "normalization_notes": [],
              "raw_id": "ev09",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "Would you like to go back to the good old days, when the population of\nthe Earth was twenty billion--about to become forty billion, then eighty\nbillion, then one hundred and sixty billion?"
        },
        {
          "anchor": {
            "end_char": 13225,
