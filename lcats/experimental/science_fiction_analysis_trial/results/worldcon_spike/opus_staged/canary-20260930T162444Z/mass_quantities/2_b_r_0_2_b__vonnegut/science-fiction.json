              "normalization_notes": [],
              "raw_id": "ev11",
              "source": "model",
              "source_chunk_id": null
            }
          ],
          "quote": "\"You think this is my idea of what life really looks\nlike?\""
        },
        {
          "anchor": {
            "end_char": 10565,
            "paragraph_ids": [
